# ============================================================================
# Viyapar Production Environment Configuration
# ============================================================================
# Copy this file to .env and update with your production values
# WARNING: Keep this file secure! Store secrets in a secrets manager for
#          production deployments (AWS Secrets Manager, HashiCorp Vault, etc.)
# ============================================================================

# ─── Environment ───
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# ─── Database Configuration ───
# For AWS RDS: rds-instance-name.xxxxxxxxxxxx.region.rds.amazonaws.com
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=viyapar
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=viyapar

# Database connection string (if needed)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ─── Redis Configuration ───
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ─── JWT Configuration ───
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_VERY_LONG_RANDOM_STRING_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Celery Configuration ───
CELERY_BROKER_URL=redis://:CHANGE_ME_TO_SECURE_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_TO_SECURE_PASSWORD@redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# ─── Celery Worker Configuration ───
CELERYD_CONCURRENCY=4
CELERYD_PREFETCH_MULTIPLIER=1
CELERYD_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_HARD_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# ─── Email Configuration (SMTP) ───
# Gmail: smtp.gmail.com (port 587)
# AWS SES: email-smtp.region.amazonaws.com (port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@viyapar.com
SMTP_FROM_NAME=Viyapar

# ─── AWS S3 Configuration ───
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_S3_URL_PREFIX=https://your-bucket-name.s3.amazonaws.com

# ─── Application URLs ───
API_URL=https://api.viyapar.com
APP_URL=https://app.viyapar.com
FRONTEND_URL=https://app.viyapar.com

# ─── CORS Configuration ───
CORS_ORIGINS=["https://app.viyapar.com","https://www.viyapar.com"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_HEADERS=["Content-Type","Authorization","Accept","X-Requested-With"]

# ─── File Upload Configuration ───
FILES_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,csv,zip

# ─── Security Configuration ───
ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ─── Rate Limiting ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=3600

# ─── Monitoring & Logging ───
# Sentry for error tracking
SENTRY_DSN=optional_sentry_dsn_url

# ─── Business Configuration ───
BUSINESS_NAME=Viyapar
BUSINESS_EMAIL=support@viyapar.com
BUSINESS_PHONE=+1-800-VIYAPAR
BUSINESS_WEBSITE=https://www.viyapar.com

# ─── Database Backup ───
# Set to true to enable automated backups
DB_BACKUP_ENABLED=true
DB_BACKUP_RETENTION_DAYS=30

# ─── Timezone ───
TIMEZONE=UTC

# ─── Feature Flags ───
FEATURE_OFFLINE_SYNC=true
FEATURE_ADVANCED_REPORTS=true
FEATURE_MULTI_TENANT=true
